# Copy this file to `.env` and paste your key into the ONE marked line below.
# With no `.env` at all the app still works in offline mode (LLM_PROVIDER=mock),
# so nothing breaks when the key is missing.

# --- which provider to use ----------------------------------------------------
# omniroute | openrouter | openai | zai | mock
# If left unset: omniroute when OMNIROUTE_API_KEY is set, else openrouter when
# OPENROUTER_API_KEY is set, else openai, else zai, else mock.
LLM_PROVIDER=omniroute

# === THE ONE PLACE TO PASTE YOUR KEY ==========================================
# Omniroute = the local OpenAI-compatible router on this machine.
OMNIROUTE_API_KEY=
# Blank = local default. Set it only if your router lives elsewhere.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Model id as the router exposes it (e.g. auto/best-fast, or openai/gpt-4o-mini).
LLM_MODEL=auto/best-fast
# ==============================================================================

# Legacy/compat: OPENROUTER_API_KEY, OPENAI_API_KEY and ZAI_API_KEY are also read
# if set. No key values are written here - keep secrets only in the git-ignored .env.

# --- input validation limits --------------------------------------------------
MIN_INPUT_CHARS=15
MAX_INPUT_CHARS=12000

# --- generation controls ------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
