# Copy this file to `.env` and paste your key into the ONE marked line below.
# With no `.env` the stack still runs offline (LLM_PROVIDER=mock + hashing embeddings).

# --- which provider answers questions ----------------------------------------
# omniroute | openrouter | openai | zai | mock
LLM_PROVIDER=omniroute

# === THE ONE PLACE TO PASTE YOUR KEY ==========================================
# Omniroute = the local OpenAI-compatible router on this machine.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
LLM_MODEL=auto/best-fast
# ==============================================================================

# Legacy/compat: OPENROUTER_API_KEY, OPENAI_API_KEY and ZAI_API_KEY are also read
# if set. No key values are written here - keep secrets only in the git-ignored .env.

# --- generation controls ------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2

# --- embeddings ---------------------------------------------------------------
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=512
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- chunking -----------------------------------------------------------------
CHUNK_SIZE=160
CHUNK_OVERLAP=40

# --- retrieval / reranking ----------------------------------------------------
TOP_K=4
CANDIDATE_K=12
MIN_SCORE=0.05
MIN_LEXICAL_OVERLAP=1
MMR_LAMBDA=0.5

# --- grounding ----------------------------------------------------------------
MIN_GROUNDEDNESS=0.55

# --- ingestion ----------------------------------------------------------------
MAX_FILE_MB=12

# --- UI -----------------------------------------------------------------------
# RAG_API_URL=http://localhost:8000
